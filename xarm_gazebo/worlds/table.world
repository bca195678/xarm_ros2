<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table</name>
      <pose>-0.1 -0.70 0 0 0 0</pose>
    </include>

    <!-- Safety fence: 3-sided (open at front/+Y toward operator) -->
    <!-- Table is centered at x=0, y=-0.84; robot at x=-0.2, y=-0.5 -->

    <!-- Safety fence: 3-sided, tight around table, ~0.40m from robot base -->
    <!-- Robot is at x=-0.2, y=-0.5 (reach=440mm). Fence at ~400mm on all 3 sides. -->

    <model name="fence_back">
      <static>true</static>
      <pose>-0.2 -0.94 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.85 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.85 0.05 1.5</size></box></geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fence_left">
      <static>true</static>
      <pose>-0.60 -0.72 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.44 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.44 1.5</size></box></geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="fence_right">
      <static>true</static>
      <pose>0.20 -0.72 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.05 0.44 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.44 1.5</size></box></geometry>
          <material>
            <ambient>1 0.8 0 1</ambient>
            <diffuse>1 0.8 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- (2022-12-20) humble: change gravity from [0 0 -9.81] to [0 0 0] -->
      <gravity>0 0 0</gravity>
    </physics>

  </world>
</sdf>
